<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007-create-digital-feature-usage-table" author="system">
        <createTable tableName="digital_feature_usage">
            <column name="usage_id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="feature_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="usage_count" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="last_used_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="usage_frequency" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="score" type="DECIMAL(5,2)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="digital_feature_usage"
                baseColumnNames="customer_id"
                constraintName="fk_digital_feature_usage_customer"
                referencedTableName="customers"
                referencedColumnNames="customer_id"
                onDelete="CASCADE"/>

        <sql>
            CREATE INDEX idx_digital_feature_usage_customer ON digital_feature_usage(customer_id);
            CREATE INDEX idx_digital_feature_usage_feature ON digital_feature_usage(feature_name);
        </sql>

        <rollback>
            <dropTable tableName="digital_feature_usage"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

