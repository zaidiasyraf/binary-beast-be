<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-transactions-table" author="system">
        <createTable tableName="transactions">
            <column name="transaction_id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="counterparty_customer_id" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="transaction_type" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="true"/>
            </column>
            <column name="direction" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="channel" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="category" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="location" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="embedding" type="vector(1024)">
                <constraints nullable="true"/>
            </column>
            <column name="content_text" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="account_id"
                constraintName="fk_transactions_account"
                referencedTableName="accounts"
                referencedColumnNames="account_id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="customer_id"
                constraintName="fk_transactions_customer"
                referencedTableName="customers"
                referencedColumnNames="customer_id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="counterparty_customer_id"
                constraintName="fk_transactions_counterparty"
                referencedTableName="customers"
                referencedColumnNames="customer_id"
                onDelete="SET NULL"/>

        <sql>
            CREATE INDEX ON transactions USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);
            CREATE INDEX idx_transactions_customer ON transactions(customer_id);
            CREATE INDEX idx_transactions_account ON transactions(account_id);
            CREATE INDEX idx_transactions_date ON transactions(transaction_date);
            CREATE INDEX idx_transactions_amount ON transactions(amount DESC);
            CREATE INDEX idx_transactions_type ON transactions(transaction_type);
            CREATE INDEX idx_transactions_category ON transactions(category);
        </sql>

        <rollback>
            <dropTable tableName="transactions"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

